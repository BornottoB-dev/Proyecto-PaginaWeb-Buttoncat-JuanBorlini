# Puerto del servidor
PORT=3001
NODE_ENV=development

# Frontend URL para CORS
CORS_ORIGIN=http://localhost:5173

# Base de datos PostgreSQL (Supabase)
# Copia la URI 'Session' o 'Direct' desde Supabase: Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres.tu_proyecto:tu_password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.tu_proyecto:tu_password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Cloudinary (Opcional para imagenes)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
